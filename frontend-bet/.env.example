# Frontend env vars. Copy to .env.local for local dev. In CI these are passed
# as Docker build args (see .github/workflows/deploy-frontend.yml).

# Backend base URL, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:9000/api

# Firebase web app config (Firebase console → Project settings → Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
