# Backend env vars. Copy to .env for local dev; production reads these from
# GCP Secret Manager / Cloud Run env config.

# ─── Identity / database ────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_analysis
REDIS_HOST=localhost

# Comma-separated emails that get auto-promoted to role=admin on first login.
ADMIN_EMAILS=

# ─── Rate limiting (legacy single-tier) ─────────────────────────────────
# The new tier-aware limits in app/core/quotas.py run regardless. These knobs
# only affect the legacy slowapi/rate_limit_dependency path.
RATE_LIMITING_ENABLE=false
RATE_LIMITING_FREQUENCY=2/3seconds
DEFAULT_MAX_REQUESTS=50
DEFAULT_RESET_DURATION=86400

# ─── External APIs ──────────────────────────────────────────────────────
ODDS_API_KEY=

# ─── LemonSqueezy billing ───────────────────────────────────────────────
# Required for /billing/checkout to work.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
# HMAC secret configured in the LS dashboard webhook settings. Required for
# /billing/webhook signature verification — without it webhooks are rejected.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Optional: where LS sends the user after a successful checkout.
# Should point at the frontend's billing-success page, e.g.
#   https://yourapp.example/billing/success
LEMONSQUEEZY_CHECKOUT_REDIRECT_URL=

# ─── GCP (production only) ──────────────────────────────────────────────
GCP_PROJECT_ID=

# ─── Dixon-Coles data + models (optional) ──────────────────────────────
# When DIXON_COLES_DATA_BUCKET is set, the same bucket holds both training
# CSVs and trained model pickles, under two prefixes:
#   gs://<bucket>/<DIXON_COLES_DATA_PREFIX>/<league>/*.csv   ← training data
#   gs://<bucket>/<DIXON_COLES_MODEL_PREFIX>/dixon_coles_<league>_model.pkl
# Leave the bucket blank in local dev — both fall back to the project's
# filesystem (./app/data/leagues and ./trained_models).
DIXON_COLES_DATA_BUCKET=
DIXON_COLES_DATA_PREFIX=leagues
DIXON_COLES_MODEL_PREFIX=models
